{
  "name": "agentonchain-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "eve dev --host 127.0.0.1 --port 2000",
    "dev:all": "node scripts/run-all-agents.mjs",
    "build": "eve build",
    "start": "eve start --host 127.0.0.1 --port 2000",
    "info": "eve info",
    "typecheck": "tsc --noEmit",
    "test:payments": "bun test payments/*.test.ts",
    "dev:helper": "node scripts/run-everyday-helper.mjs dev --host 127.0.0.1 --port 2001",
    "build:helper": "node scripts/run-everyday-helper.mjs build",
    "start:helper": "node scripts/run-everyday-helper.mjs start --host 127.0.0.1 --port 2001",
    "info:helper": "node scripts/run-everyday-helper.mjs info",
    "dev:chat": "node scripts/run-chat-agent.mjs dev --host 127.0.0.1 --port 2002",
    "build:chat": "node scripts/run-chat-agent.mjs build",
    "start:chat": "node scripts/run-chat-agent.mjs start --host 127.0.0.1 --port 2002",
    "info:chat": "node scripts/run-chat-agent.mjs info",
    "ask:chat": "eve invoke --url http://127.0.0.1:2002"
  },
  "dependencies": {
    "@ai-sdk/groq": "4.0.54",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/mcp": "2.28.0",
    "ai": "7.0.127",
    "ethers": "^6.17.0",
    "eve": "0.56.0",
    "viem": "2.57.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5"
  }
}
