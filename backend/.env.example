# Copy to .env.local and set your Groq API key.
GROQ_API_KEY=

# Optional: choose a model available to your Groq account.
GROQ_MODEL=openai/gpt-oss-20b

# Seller-side x402: required to enable the two paid MCP ask_agent tools.
# A public Ethereum address receives test USDC; no seller private key is needed.
X402_RECIPIENT=
X402_FACILITATOR_URL=https://x402.org/facilitator
